<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The sample Greeter server runs on the developer's machine through adb reverse. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <!-- Debug builds only: trust user-installed CAs (e.g. the Flocon Desktop proxy CA)
         so the proxy mode can intercept HTTPS calls. Release builds keep system CAs only. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
